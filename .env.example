# Copy to .env (never commit real values)
PORT=3000
# Token Meta sends when verifying the webhook (GET). Use a long random value in production.
VERIFY_TOKEN=change-me
# Database file location (default: ./data.db). Keep it outside the code folder in production.
DB_PATH=data.db
# Dashboard and /api/* login (HTTP Basic). REQUIRED when NODE_ENV=production; use a long password.
DASHBOARD_USER=manager
DASHBOARD_PASSWORD=change-me
CONFIDENCE_THRESHOLD=0.5
# Optional: staff alerts via Telegram. If empty, alerts print to console (simulated).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to 1 to force the notifier to fail (demonstrates failure path)
NOTIFY_FORCE_FAIL=0
